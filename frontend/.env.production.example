# Production build — Hostinger erp.dhurandharcrm.com
# Set in hPanel build env OR copy to frontend/.env.production before npm run build.
#
# Same-origin API: SPA and Express share https://erp.dhurandharcrm.com

VITE_USE_API=true
VITE_API_BASE_URL=/api/v1
VITE_TENANT_SLUG=vasant-trailers

# --- Stage (optional) — SPA calling separate API host ---
# VITE_USE_API=true
# VITE_API_BASE_URL=https://stageapi.dhurandharcrm.com/api/v1
# VITE_TENANT_SLUG=vasant-trailers
