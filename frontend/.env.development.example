# Local development — copy to frontend/.env.development (Vite loads this on npm run dev)
#   cp .env.development.example .env.development
#
# Or copy to frontend/.env if you prefer a single file.

# --- API mode (backend on :5000) ---
# Prefer same-origin /api/v1 so Vite proxies to the backend (stable CORS / no host mismatch).
VITE_USE_API=true
VITE_API_BASE_URL=/api/v1
VITE_TENANT_SLUG=vasant-trailers

# Direct backend URL also works when CORS allows your page origin:
# VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1

# --- Demo mode (no backend; Zustand seed data) ---
# VITE_USE_API=false
# VITE_API_BASE_URL=http://localhost:5000/api/v1
# VITE_TENANT_SLUG=vasant-trailers
