# Backend environment — see split templates:
#   .env.development.example  → local (copy to .env)
#   .env.production.example   → Hostinger erp.dhurandharcrm.com (hPanel env vars)

DB_HOST=localhost
DB_PORT=3306
DB_NAME=fos_erp
DB_USER=root
DB_PASS=

PORT=5000
NODE_ENV=development

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

# Optional SMTP — invitations + password-reset delivery
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="FOS ERP <noreply@example.com>"

# Optional — treasury / field encryption (see src/config/env.ts)
# TREASURY_ACCOUNT_HMAC_SECRET=change-me-hmac-secret-min-16
# FIELD_ENCRYPTION_KEY=

# Optional — Copilot / Knowledge Base generative chat (backend only; never commit real keys)
# Google Gemini (recommended): get key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
# KB_CHAT_MODEL=gemini-2.0-flash
#
# OpenAI (alternative):
# OPENAI_API_KEY=sk-...
# KB_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# KB_EMBEDDING_MODEL=text-embedding-3-small
