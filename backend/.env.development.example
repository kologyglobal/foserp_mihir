# Local development — copy to backend/.env
#   cp .env.development.example .env
#
# Then: npm run db:setup && npm run dev
#
# PRIMARY: XAMPP (or other host) MySQL/MariaDB on 3306 with database fos_erp.
# Do not bind Docker MySQL to host 3306 while XAMPP is running.
# Optional isolated Docker MySQL: host 3307 — see docker-compose.local-mysql.yml

NODE_ENV=development
PORT=5000

# Local MySQL (XAMPP primary on this repo's typical Windows setup)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fos_erp
DB_USER=root
DB_PASS=

# Optional — prisma-cli / migrate uses DB_* above; only set if you prefer one URL:
# DATABASE_URL=mysql://root@localhost:3306/fos_erp

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Vite dev server origin (CORS)
FRONTEND_URL=http://localhost:5173

CRM_UPLOAD_DIR=./uploads
CRM_MAX_UPLOAD_BYTES=26214400

# Optional — Copilot / Knowledge Base (generative answers; backend only)
# Get a Gemini key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
# KB_CHAT_MODEL=gemini-2.0-flash
#
# OpenAI alternative:
# OPENAI_API_KEY=sk-...
# KB_CHAT_MODEL=gpt-4o-mini
