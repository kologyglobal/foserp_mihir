# Local development — copy to backend/.env
#   cp .env.development.example .env
#
# Then: npm run db:setup && npm run dev

NODE_ENV=development
PORT=5000

# Local MySQL (XAMPP / Docker / native)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fos_erp
DB_USER=root
DB_PASS=

# Optional — prisma-cli / migrate uses DB_* above; only set if you prefer one URL:
# DATABASE_URL=mysql://root@localhost:3306/fos_erp

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Vite dev server origin (CORS)
FRONTEND_URL=http://localhost:5173

CRM_UPLOAD_DIR=./uploads
CRM_MAX_UPLOAD_BYTES=26214400
