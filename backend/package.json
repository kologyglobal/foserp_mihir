{
  "name": "fos-erp-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <=22"
  },
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build-hostinger-deploy.mjs",
    "build:app": "node scripts/ensure-prisma-client.mjs && node scripts/clean-dist.mjs && node scripts/compile-dist.mjs && node scripts/verify-dist-critical.mjs",
    "build:app:compile": "node scripts/clean-dist.mjs && node scripts/compile-dist.mjs && node scripts/verify-dist-critical.mjs",
    "build:app:force-prisma": "node scripts/ensure-prisma-client.mjs --force && npm run build:app:compile",
    "build:app:tsc": "node scripts/ensure-prisma-client.mjs && node scripts/clean-dist.mjs --keep-tsbuildinfo && node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.build.json && node scripts/verify-dist-critical.mjs",
    "build:with-migrate": "node scripts/migrate-deploy.mjs && npm run build:app",
    "postinstall": "node scripts/ensure-prisma-client.mjs",
    "start": "node dist/server.js",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:purchase-phase15": "vitest run tests/purchase-phase15-unit.test.ts tests/purchase-planning-workflow.test.ts tests/purchase-requisition-workflow.test.ts tests/purchase-error-catalog.test.ts tests/purchase-rbac-permissions.test.ts tests/purchase-rfq-workflow.test.ts tests/purchase-audit-timeline.test.ts",
    "test:purchase-phase15-live": "vitest run tests/purchase-phase15-integration.test.ts tests/purchase-requisition-lifecycle.test.ts tests/purchase-planning-sheet.test.ts tests/purchase-module-coverage.test.ts --hookTimeout=120000",
    "test:purchase-grn-live": "vitest run tests/goods-receipt-lifecycle.test.ts --hookTimeout=120000",
    "test:purchase-po-live": "vitest run tests/purchase-order-lifecycle.test.ts --hookTimeout=120000",
    "test:purchase-setup-live": "vitest run tests/purchase-setup.test.ts --hookTimeout=120000",
    "test:purchase-approvals-live": "vitest run tests/purchase-approvals.test.ts tests/purchase-approval-flow.test.ts --hookTimeout=120000",
    "test:purchase-invoice-live": "vitest run tests/purchase-invoice-lifecycle.test.ts tests/purchase-invoice-lifecycle-live.test.ts --hookTimeout=120000",
    "test:purchase-qi-live": "vitest run tests/purchase-qi-lifecycle.test.ts --hookTimeout=120000",
    "test:purchase-return-live": "vitest run tests/purchase-return-lifecycle.test.ts --hookTimeout=120000",
    "test:supplier-quality-closure-live": "vitest run tests/supplier-quality-closure-live.test.ts --hookTimeout=180000",
    "test:purchase-coverage-live": "vitest run tests/purchase-module-coverage.test.ts --hookTimeout=120000",
    "test:purchase-multi-unit-uom-live": "tsx scripts/test-purchase-multi-unit-uom-flow.ts",
    "test:pr-to-grn-stock-e2e": "tsx scripts/test-pr-to-grn-stock-e2e.ts",
    "test:grn-tolerance": "vitest run tests/purchase/grn-tolerance.test.ts",
    "test:grn-tolerance-live": "tsx scripts/test-grn-tolerance-flow.ts",
    "test:fin-close-1-live": "tsx scripts/test-fin-close-1-grir-ppv-return-ap.ts",
    "test:purchase-retro-cost-live": "vitest run tests/purchase-invoice-retro-cost-live.test.ts --no-file-parallelism --hookTimeout=120000",
    "test:inventory-costing": "vitest run tests/inventory-moving-average.test.ts tests/inventory-fifo-layers.test.ts tests/inventory-costing-phasec.test.ts tests/inventory-fifo-return-restore.test.ts tests/inventory-fifo-opening-migration.test.ts tests/inventory-costing-uat1-controlled.test.ts tests/inventory-costing-golden-path-ma-fifo.test.ts --pool=forks --maxWorkers=1 --hookTimeout=120000",
    "test:inventory-gl-recon-live": "vitest run tests/inventory-costing-gl-recon-parity.test.ts --pool=forks --maxWorkers=1 --hookTimeout=180000",
    "test:inventory-costing-spa-uat": "tsx scripts/test-inventory-costing-spa-uat-harness.ts",
    "seed:grn-tolerance-review": "tsx scripts/seed-grn-tolerance-review-pack.ts",
    "test:crm-live": "tsx scripts/run-crm-live-tests.ts",
    "test:auth-self-service": "vitest run tests/auth-hardening.test.ts tests/auth-self-service.test.ts",
    "test:admin-iam-smoke": "vitest run tests/admin-tenants-users-roles-smoke.test.ts tests/admin-security-regression.test.ts",
    "test:backend-structure": "tsx scripts/test-backend-structure.ts",
    "swagger:generate": "tsx scripts/generate-swagger-paths.ts",
    "verify:finance-integrity": "tsx scripts/verify-finance-integrity.ts",
    "db:purge-business": "tsx scripts/purge-business-data.ts",
    "test:watch": "vitest",
    "db:generate": "tsx scripts/prisma-cli.ts generate",
    "db:migrate": "tsx scripts/prisma-cli.ts migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:hostinger": "node scripts/migrate-deploy.mjs",
    "db:recover-known": "node scripts/migrate-recover-known-blockers.mjs",
    "db:resolve-phase10": "node scripts/resolve-phase10-p3009.mjs",
    "db:recover-live-p3009": "tsx scripts/recover-live-p3009-blockers.ts",
    "db:recover-live-p3018": "tsx scripts/recover-live-p3018-blockers.ts",
    "db:audit-item-gst-hsn": "tsx scripts/audit-item-gst-hsn.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:purchase-demo": "tsx scripts/seed-purchase-demo-data.ts",
    "db:seed:purchase-test-pack": "tsx scripts/seed-purchase-test-pack.ts",
    "db:sync-permissions": "tsx scripts/sync-permissions.ts",
    "db:repair-gst-utgst": "tsx scripts/repair-master-gst-rates-utgst.ts",
    "uat:gst-books": "tsx scripts/uat-gst-books-period.ts",
    "db:setup": "npm run db:generate && tsx scripts/prisma-cli.ts migrate deploy && npm run db:seed",
    "db:studio": "tsx scripts/prisma-cli.ts studio"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.5.0",
    "esbuild": "^0.25.12",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "ssh2-sftp-client": "^12.1.1",
    "supertest": "^7.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "vitest": "^3.2.3"
  }
}
