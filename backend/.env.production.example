# Production — Hostinger erp.dhurandharcrm.com
# Set these in hPanel → Node.js Web App → Environment Variables (never commit real secrets).
#
# Single-host deploy: SPA + API on https://erp.dhurandharcrm.com
# Health: GET https://erp.dhurandharcrm.com/api/v1/health

NODE_ENV=production
# Hostinger assigns PORT — do not hardcode in hPanel unless required.

# MySQL — use exact names from hPanel → Databases (NOT u233611619_fos_erp)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u233611619_foserp
DB_USER=u233611619_erpuser_jul
DB_PASS=CHANGE_ME

# If password contains @ encode as %40 in DATABASE_URL only:
# DATABASE_URL=mysql://u233611619_erpuser_jul:CHANGE_ME%40HERE@127.0.0.1:3306/u233611619_foserp

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS!!
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public SPA URL (CORS) — same host as API on production
FRONTEND_URL=https://erp.dhurandharcrm.com

CRM_UPLOAD_DIR=./uploads
CRM_MAX_UPLOAD_BYTES=26214400

# --- Stage API (optional split host) ---
# If API runs on stageapi.dhurandharcrm.com and SPA on stage.dhurandharcrm.com:
# FRONTEND_URL=https://stage.dhurandharcrm.com
# DB_* same as above when DB is shared with prod/stage
