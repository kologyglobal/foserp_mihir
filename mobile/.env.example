# Copy to .env for local development. Never commit real secrets.
# Public vars only — no JWT/DB credentials in the mobile bundle.

# development | uat | production
EXPO_PUBLIC_APP_ENV=development

# Must end with /api/v1 (no trailing slash after v1 is also OK — client normalizes)
# Device/emulator: use your machine LAN IP, not localhost (e.g. http://192.168.1.10:5000/api/v1)
# Android emulator host loopback: http://10.0.2.2:5000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000/api/v1

# Optional pre-fill on login form only
EXPO_PUBLIC_DEFAULT_TENANT_SLUG=vasant-trailers

EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_NUMBER=1
